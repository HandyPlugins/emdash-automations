{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "automations",
	"publisher": "did:plc:6kdx7jauswq2awrp3yfxbbw5",
	"name": "Automations",

	"license": "MIT",
	"author": { "name": "HandyPlugins", "url": "https://handyplugins.co" },
	"security": { "email": "support@handyplugins.co" },
	"repo": "https://github.com/HandyPlugins/emdash-automations",
	"description": "Automate your EmDash site with triggers and actions.",

	// Minimal event, schema, network, and email access; no CMS write access.
	// Changes to the trust contract require a version bump after release.
	"capabilities": ["content:read", "media:read", "schema:read", "network:request:unrestricted", "email:send"],
	"allowedHosts": [],
	"storage": {
    "automations": { "indexes": ["enabled", "triggerType", "updatedAt", ["enabled", "triggerType"]] },
    "runs": { "indexes": ["automationId", "startedAt", ["automationId", "startedAt"]] }
  },
  "admin": { "pages": [{ "path": "/manage", "label": "Automations", "icon": "zap" }] }
}
